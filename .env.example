# Copy to .env and fill in ONE provider. The app works without any key
# (it answers from the clinic file with a "Answered from the clinic file" label).

# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model. Current default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# DeepSeek (OpenAI-compatible). https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Generic OpenAI-compatible endpoint (e.g. Z.ai). Leave base URL blank for DeepSeek.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=

# Server
PORT=3000